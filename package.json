{
  "name": "yanzhi-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "言志系 · 观测站：采集、生成、发布与校验流水线",
  "scripts": {
    "observatory:collect": "node scripts/observatory/collect.mjs",
    "observatory:generate": "node scripts/observatory/generate.mjs",
    "observatory:publish": "node scripts/observatory/publish.mjs",
    "observatory:verify": "node scripts/observatory/verify.mjs",
    "observatory:search-health": "node scripts/observatory/search-health.mjs",
    "test": "node --test tests/*.test.mjs",
    "heartbeat:deploy": "wrangler deploy --config workers/wrangler.jsonc",
    "heartbeat:dev": "wrangler dev --config workers/wrangler.jsonc"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
